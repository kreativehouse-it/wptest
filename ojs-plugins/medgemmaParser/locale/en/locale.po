msgid "plugins.generic.medgemmaParser.displayName"
msgstr "MedGemma Manuscript Analysis"

msgid "plugins.generic.medgemmaParser.description"
msgstr "Sends manuscripts uploaded by authors to a MedGemma model on AWS SageMaker and extracts metadata, clinical data and a pre-review checklist that editors see in the workflow."

msgid "plugins.generic.medgemmaParser.tab"
msgstr "AI analysis"

msgid "plugins.generic.medgemmaParser.disclaimer"
msgstr "Generated automatically by MedGemma and may contain errors. Always check them against the manuscript."

