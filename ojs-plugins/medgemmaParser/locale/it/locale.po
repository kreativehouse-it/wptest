msgid "plugins.generic.medgemmaParser.displayName"
msgstr "Analisi manoscritti MedGemma"

msgid "plugins.generic.medgemmaParser.description"
msgstr "Invia i manoscritti caricati dagli autori a un modello MedGemma su AWS SageMaker ed estrae metadati, dati clinici e una checklist di pre-review, visibili agli editor nel workflow."

msgid "plugins.generic.medgemmaParser.tab"
msgstr "Analisi AI"

msgid "plugins.generic.medgemmaParser.disclaimer"
msgstr "Risultati generati automaticamente da MedGemma: possono contenere errori. Verificali sempre sul manoscritto."

